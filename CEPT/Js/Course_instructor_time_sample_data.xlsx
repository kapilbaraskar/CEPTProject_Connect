            	}
			]
        },

        "aaData": JSON.parse(data),

        "aoColumns": [
            { "sTitle": "Course Code", "mData": "course_code", "bSortable": false },
            //{ "sTitle": "Course Total Marks", "mData": "Course_Total_Marks", "bSortable": false },
            //{"sTitle": "Total Students", "mData": "Total_Students", "bSortable": false },
            //{ "sTitle": "Average Marks", "mData": "Average", "bSortable": false },
            //{ "sTitle": "Standard Deviation", "mData": "SD", "bSortable": false },
            
            {"sTitle": "Average Marks", "mData": null, "bSortable": false, fnRender: function (data) {
                //(67.4897586206897).toFixed(2)
                return parseFloat(data.aData.Average).toFixed(2);
            }
            },
            { "sTitle": "Standard Deviation", "mData": null, "bSortable": false, fnRender: function (data) {
                //(67.4897586206897).toFixed(2)
                return parseFloat(data.aData.SD).toFixed(2);
            }
            },
            
            //{ "sTitle": "A+ From", "mData": "A_plus_from", "bSortable": false },
            //{ "sTitle": "A From", "mData": "A_from", "bSortable": false },
            //{ "sTitle": "A- From", "mData": "A_minus_from", "bSortable": false },
            //{ "sTitle": "B+ From", "mData": "B_plus_from", "bSortable": false },
            //{ "sTitle": "B From", "mData": "B_from", "bSortable": false },
            //{ "sTitle": "B- From", "mData": "B_minus_from", "bSortable": false },
            //{ "sTitle": "C+ From", "mData": "C_plus_from", "bSortable": false },
            //{ "sTitle": "C From", "mData": "C_from", "bSortable": false },
            //{ "sTitle": "C- From", "mData": "C_minus_from", "bSortable": false },

            {"sTitle": "A+", "mData": null, "bSortable": false, fnRender: function (data) {
                return data.aData.A_plus_from + ' - ' + data.aData.A_plus_to;
            }
            },
            { "sTitle": "A", "mData": null, "bSortable": false, fnRender: function (data) {
                return data.aData.A_from + ' - ' + data.aData.A_to;
            }
            },
            { "sTitle": "A-", "mData": null, "bSortable": false, fnRender: function (data) {
                return data.aData.A_minus_from + ' - ' + data.aData.A_minus_to;
            }
            },
            { "sTitle": "B+", "mData": null, "bSortable": false, fnRender: function (data) {
                return data.aData.B_plus_from + ' - ' + data.aData.B_plus_to;
            }
            },
            { "sTitle": "B", "mData": null, "bSortable": false, fnRender: function (data) {
