    <style>
        div.ajax-loading {
            position: fixed;
            top: 0;
            left: 0;
            z-index: 9999999;
            background-color: white;
            opacity: 0.7;
            filter: alpha(opacity=70); /* ie */
            -moz-opacity: 0.7; /* mozilla */
            display: none;
        }

            div.ajax-loading * {
                background-color: white;
                background-position: center center;
                background-repeat: no-repeat;
                opacity: 1;
                filter: alpha(opacity=100); /* ie */
                -moz-opacity: 1; /* mozilla */
            }

        .logo {
            color: #fff;
            font-size: 20px;
            vertical-align: middle;
        }

        .cssmenu .has-sub .has-sub ul li a, .cssmenu .has-sub .has-sub ul li a:hover {
            background: #5B9BD5 !important;
        }
 .swal2-popup {
  font-size: 0.8rem !important;
  font-family: Georgia, serif;
  font-weight:bold;
  color:blue;
}
    </style>
    <script language="javascript" type="text/javascript">
        //$(document).ready(function myfunction() {
        ////    $('body').perfectScrollbar({ wheelSpeed: 50, minScrollbarLength: 20 });
        ////    //$('body').css('max-height', '700px');
        ////    $('body').height($(window).height());
        //});

        window.ajaxEnabled = true;
        window.is_msg_on = false;
        $.ajaxSetup({
            beforeSend: function (e, a, b) {
                if (a.url == check_session_url) {
                    $("#loading").hide();
                    return true;
                }
                else {
                    if (!window.ajaxEnabled) {
                        //alert('Your session has expired. Please log in again.');
                        if (!window.is_msg_on) {
                            window.is_msg_on = true;
                            bootbox.alert('Session expired, Please login to continue.', function () {
                                window.is_msg_on = false;
                            });
                        }
                    }

                    return window.ajaxEnabled;
                }
            }
        });

        $(document).ajaxStart(function () {
            $("#loading").show();
        });

        $(document).ajaxStop(function () {
            $("#loading").hide();
        });

