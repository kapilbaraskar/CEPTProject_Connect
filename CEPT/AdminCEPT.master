    <script type="text/javascript">
        function GetTotalWidth() {
            let TotalWidth = 0.0;
            Array.from($("#main_manu").children()).forEach(function (e) { TotalWidth += e.offsetWidth; });
            return TotalWidth + 1;
        }
        setTimeout(function () {
            $("#i2bdh68b")[0].style.left = $("#i22byw40")[0].offsetLeft - $("#i2bdh68b")[0].offsetWidth + 'px';
            if (($("#main")[0].offsetLeft + GetTotalWidth()) > $("#i2bdh68b")[0].offsetLeft) {
                $("#main")[0].style.marginLeft = ((($("#main")[0].style.marginLeft.split('%')[0] * $("#main")[0].offsetWidth) / 100) - (($("#main")[0].offsetLeft + GetTotalWidth()) - $("#i2bdh68b")[0].offsetLeft)) + 'px';
            }
        }, 200);
