        function setDataTableHeaderFooter(id) {
            var table_id = id;

            // Header Width
            if ($("#" + table_id + "_wrapper")[0].children[0] != undefined) {
                $("#" + table_id + "_wrapper")[0].children[0].style.width = '' + $('#' + table_id)[0].offsetWidth + 'px';
                $("#" + table_id + "_wrapper")[0].children[0].style.height = '45px';
            }

            // Header TableTools Button
            if ($("#" + table_id + "_wrapper")[0].children[0].children[0].getElementsByClassName('DTTT_container')[0] != undefined) {
                $("#" + table_id + "_wrapper")[0].children[0].children[0].getElementsByClassName('DTTT_container')[0].style.position = 'absolute';
                $("#" + table_id + "_wrapper")[0].children[0].children[0].getElementsByClassName('DTTT_container')[0].style.left = '447px';
            }

            // Header Search
            $("#" + table_id + "_filter").css('position', 'absolute');
            $("#" + table_id + "_filter").css('width', '350px');
            $("#" + table_id + "_filter").css('left', '680px');

            // Footer Width
            if ($("#" + table_id + "_wrapper")[0].children[2] != undefined) {
                $("#" + table_id + "_wrapper")[0].children[2].style.width = '' + $('#' + table_id)[0].offsetWidth + 'px';
            }

            // Footer Showing entries
            if ($("#" + table_id + "_wrapper")[0].children[2].children[0].children[0] != undefined) {
                $("#" + table_id + "_wrapper")[0].children[2].children[0].children[0].style.position = 'absolute';
            }

            // Footer Pagination
            if ($("#" + table_id + "_wrapper")[0].children[2].children[1].children[0] != undefined) {
                $("#" + table_id + "_wrapper")[0].children[2].children[1].children[0].style.position = 'absolute';
                $("#" + table_id + "_wrapper")[0].children[2].children[1].children[0].style.width = '330px';
                $("#" + table_id + "_wrapper")[0].children[2].children[1].children[0].style.left = '680px';
            }
        }

        function change_user_role(role) {
            $('#HdnUserRole').val(role);
            $('#Button1').click();
        }

        var check_session_url = '<%= Page.ResolveClientUrl("~/WebService.asmx/check_session") %>';
        function check_user_session() {
            $.ajax({
                type: "POST",
                url: check_session_url,
                async: false,
                data: "{}",
                contentType: "application/json",
                cache: false,
                datatype: "json",
                success: function (data) {
                    if (data.d == false) {
                        window.ajaxEnabled = false;
                        //alert('Your session has expired. Please log in again.');

                        if (!window.is_msg_on) {
                            window.is_msg_on = true;
                            bootbox.alert('Session expired, Please login to continue.', function () {
                                window.is_msg_on = false;
                            });
                        }
                    }
                    else {
                        window.ajaxEnabled = true;
                    }
                },
                error: function (data) {
                    //alert(data.d);
                }
            });
        }
    </script>
</head>
