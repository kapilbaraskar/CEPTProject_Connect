     <asp:ContentPlaceHolder id="ContentPlaceHolder1" runat="server">
        
        </asp:ContentPlaceHolder>
<script>
    const body = document.querySelector("body");
    const sidebar = document.querySelector(".sidebar");
    const submenuItems = document.querySelectorAll(".submenu_item");
    const sidebarOpen = document.querySelector("#sidebarOpen");
    const sidebarExpand = document.querySelector(".expand_sidebar");

    const sidebarClose = document.querySelector(".collapse_sidebar"); // This might be null if removed

    // Toggle sidebar open/close
    sidebarOpen.addEventListener("click", () => sidebar.classList.toggle("close"));

    // Only add event listeners if collapse_sidebar exists
    if (sidebarClose) {
        sidebarClose.addEventListener("click", () => {
            sidebar.classList.add("close", "hoverable");
        });
    }

    if (sidebarExpand) {
        sidebarExpand.addEventListener("click", () => {
            sidebar.classList.remove("close", "hoverable");
        });
    }

    // Sidebar hover effects
    sidebar.addEventListener("mouseenter", () => {
        if (sidebar.classList.contains("hoverable")) {
            sidebar.classList.remove("close");
        }
    });
    sidebar.addEventListener("mouseleave", () => {
        if (sidebar.classList.contains("hoverable")) {
            sidebar.classList.add("close");
        }
    });

    // Dropdown Menu Toggle
    const dropdownBtn = document.getElementById("dropdownBtn");
    if (dropdownBtn) {
        dropdownBtn.addEventListener("click", function (event) {
            event.stopPropagation();
            document.getElementById("dropdownMenu").classList.toggle("show");
        });
    }

    // Handle submenu clicks
    submenuItems.forEach((item, index) => {
        item.addEventListener("click", () => {
            item.classList.toggle("show_submenu");
            submenuItems.forEach((item2, index2) => {
                if (index !== index2) {
                    item2.classList.remove("show_submenu");
                }
            });
        });
    });

    // Responsive sidebar behavior
    if (window.innerWidth < 768) {
        sidebar.classList.add("close");
    } else {
        sidebar.classList.remove("close");
    }

    // Sidebar margin adjustment
    document.getElementById("sidebarOpen").addEventListener("click", () => {
        const content = document.querySelector(".main-content");
        content.style.marginLeft = sidebar.classList.contains("close") ? "80px" : "260px";
    });

</script>
 
 
</html>

